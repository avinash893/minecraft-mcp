# Pterodactyl Panel Configuration
# URL of your Pterodactyl control panel (e.g., https://panel.yourhost.com)
PTERO_URL=https://panel.example.com

# Client API key generated under Account Settings -> API Credentials
PTERO_KEY=ptlc_your_api_key_here

# Server identifier (the 8-character short ID from the panel URL)
PTERO_SERVER=your_server_id_here

# Set to true for headless browser execution if desired (default: false)
PTERO_HEADLESS=false
